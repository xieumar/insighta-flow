# ============================================================
# Insighta Flow — Environment Variables Reference
# Copy this file to .env in each package and fill in values.
# Never commit actual .env files.
# ============================================================

# ---- BACKEND (backend/.env) --------------------------------
# Neon PostgreSQL connection string
# Get this from: https://console.neon.tech → your project → Connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/insighta_flow?sslmode=require

# Express server port
PORT=4000

# Basic Auth credentials (protect all /api/* routes)
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=changeme

# ---- FRONTEND (frontend/.env.local) -----------------------
# Base URL of the backend API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Must match the backend BASIC_AUTH_* values
# Used by the frontend login form to validate credentials client-side
# before issuing the auth cookie.
NEXT_PUBLIC_APP_USERNAME=admin
NEXT_PUBLIC_APP_PASSWORD=changeme
