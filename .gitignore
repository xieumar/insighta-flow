# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Environment variables ─────────────────────────────────────
.env
.env.*
!.env.example

# ── Next.js ──────────────────────────────────────────────────
frontend/.next/
frontend/out/

# ── Backend build ─────────────────────────────────────────────
backend/dist/

# ── Testing ───────────────────────────────────────────────────
coverage/
playwright-report/
test-results/

# ── OS / Editor ───────────────────────────────────────────────
.DS_Store
*.pem
Thumbs.db
.idea/
.vscode/settings.json

# ── Debug logs ────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── TypeScript build cache ────────────────────────────────────
*.tsbuildinfo
frontend/next-env.d.ts

# ── Vercel ────────────────────────────────────────────────────
.vercel

# ── Prisma ────────────────────────────────────────────────────
