generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  full_name          String
  gender             String
  age                Int
  country            String
  income             Float
  purchased_category String
  created_at         DateTime @default(now())

  @@index([full_name, age])
}

model Workspace {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @default("Untitled Workspace")
  query_tree  Json
  dataset_id  String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}
